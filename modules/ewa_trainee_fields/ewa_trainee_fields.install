    'field_step_grade' => ['type' => 'integer', 'label' => 'STEP grade', 'ar' => 'درجة اختبار STEP', 'field' => ['min' => 0, 'max' => 100], 'group' => 'academic'],
    'field_gpa' => ['type' => 'decimal', 'label' => 'GPA', 'ar' => 'المعدل التراكمي', 'storage' => ['precision' => 4, 'scale' => 2], 'field' => ['min' => 0, 'max' => 5], 'group' => 'academic'],
    'field_university' => ['type' => 'string', 'label' => 'University / Institute', 'ar' => 'الجامعة / المعهد', 'storage' => ['max_length' => 255], 'group' => 'academic'],

    // ---- Employment & eligibility
    'field_employed' => ['type' => 'boolean', 'label' => 'Currently employed', 'ar' => 'يعمل حاليًا', 'field' => $yes_no, 'group' => 'employment'],
    'field_social_insurance' => ['type' => 'boolean', 'label' => 'Registered in social insurance (GOSI)', 'ar' => 'مسجّل في التأمينات الاجتماعية', 'field' => $yes_no, 'group' => 'employment'],
    'field_qiwa' => ['type' => 'boolean', 'label' => 'Registered in Qiwa', 'ar' => 'مسجّل في منصة قوى', 'field' => $yes_no, 'group' => 'employment'],
    'field_commercial_reg' => ['type' => 'boolean', 'label' => 'Has a commercial registration', 'ar' => 'لديه سجل تجاري', 'field' => $yes_no, 'group' => 'employment'],
    'field_hrdf' => ['type' => 'boolean', 'label' => 'Benefited from HRDF', 'ar' => 'استفاد من صندوق تنمية الموارد البشرية (هدف)', 'field' => $yes_no, 'group' => 'employment'],
    'field_referral' => ['type' => 'list_string', 'label' => 'How did you hear about EWA?', 'ar' => 'كيف عرفت عن الأكاديمية؟', 'values' => [
      'social-media' => ['Social Media', 'وسائل التواصل الاجتماعي'],
      'website' => ['EWA Website', 'موقع الأكاديمية'],
      'friend' => ['Friend or Family', 'صديق أو أحد أفراد العائلة'],
      'employer' => ['Employer', 'جهة العمل'],
      'event' => ['Event / Exhibition', 'فعالية / معرض'],
      'other' => ['Other', 'أخرى'],
    ], 'group' => 'employment'],
    'field_data_confirm' => ['type' => 'boolean', 'label' => 'Data confirmed as correct', 'ar' => 'تم تأكيد صحة البيانات', 'field' => $yes_no, 'group' => 'employment'],

    // ---- Selected programs (taxonomy "programs")
    'field_programs' => ['type' => 'entity_reference', 'label' => 'Selected programs', 'ar' => 'البرامج المختارة', 'cardinality' => -1, 'storage' => ['target_type' => 'taxonomy_term'], 'field' => [
      'handler' => 'default:taxonomy_term',
      'handler_settings' => ['target_bundles' => ['programs' => 'programs'], 'auto_create' => FALSE],
    ], 'group' => 'programs'],
  ];
}

/** Form widget and display formatter per field type. */
function ewa_trainee_fields_display(string $type): array {
  return match ($type) {
    'string' => ['string_textfield', 'string'],
    'list_string' => ['options_select', 'list_default'],
    'datetime' => ['datetime_default', 'datetime_default'],
    'integer' => ['number', 'number_integer'],
    'decimal' => ['number', 'number_decimal'],
    'boolean' => ['boolean_checkbox', 'boolean'],
    'entity_reference' => ['options_buttons', 'entity_reference_label'],
  };
}

/**
 * Implements hook_install().
 */
function ewa_trainee_fields_install(): void {
  $definitions = ewa_trainee_fields_definitions();
  $created = [];

  foreach ($definitions as $name => $def) {
    if (!FieldStorageConfig::loadByName('user', $name)) {
      $storage_settings = $def['storage'] ?? [];
      if ($def['type'] === 'list_string') {
        $storage_settings['allowed_values'] = array_map(fn($labels) => $labels[0], $def['values']);
      }
      FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'user',
        'type' => $def['type'],
        'cardinality' => $def['cardinality'] ?? 1,
        'settings' => $storage_settings,
      ])->save();
    }
    if (!FieldConfig::loadByName('user', 'user', $name)) {
      FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $def['label'],
        'description' => $def['description'] ?? '',
        // fields are filled by the registration form, so not required in the admin form
        'required' => FALSE,
        'settings' => $def['field'] ?? [],
      ])->save();
      $created[] = $name;
    }
  }

  // Form + view displays, in registration order (after the account fields)
  $form = EntityFormDisplay::load('user.user.default') ?? EntityFormDisplay::create(['targetEntityType' => 'user', 'bundle' => 'user', 'mode' => 'default', 'status' => TRUE]);
  $view = EntityViewDisplay::load('user.user.default') ?? EntityViewDisplay::create(['targetEntityType' => 'user', 'bundle' => 'user', 'mode' => 'default', 'status' => TRUE]);
  $weight = 20;
  foreach ($definitions as $name => $def) {
    [$widget, $formatter] = ewa_trainee_fields_display($def['type']);
    if (!$form->getComponent($name)) {
      $form->setComponent($name, ['type' => $widget, 'weight' => $weight]);
    }
    if (!$view->getComponent($name)) {
      $settings = $def['type'] === 'datetime' ? ['format_type' => 'medium'] : [];
      $view->setComponent($name, ['type' => $formatter, 'label' => 'inline', 'weight' => $weight, 'settings' => $settings]);
    }
    $weight++;
  }
  $form->save();
  $view->save();

  ewa_trainee_fields_translate($definitions);

  \Drupal::messenger()->addStatus(t('EWA Trainee Fields: @count user fields created.', ['@count' => count($created)]));
}

/**
 * Arabic labels (and list option labels), when the site has Arabic and language module.
 */
function ewa_trainee_fields_translate(array $definitions): void {
  $languages = \Drupal::languageManager();
  if (!\Drupal::moduleHandler()->moduleExists('language') || !$languages->getLanguage('ar') || !method_exists($languages, 'getLanguageConfigOverride')) {
    return;
  }
  foreach ($definitions as $name => $def) {
    $languages->getLanguageConfigOverride('ar', "field.field.user.user.$name")->set('label', $def['ar'])->save();
    if ($def['type'] === 'list_string') {
      $values = [];
      foreach ($def['values'] as $key => $labels) {
        $values[] = ['value' => $key, 'label' => $labels[1]];
      }
      $languages->getLanguageConfigOverride('ar', "field.storage.user.$name")->set('settings.allowed_values', $values)->save();
    }
    if ($def['type'] === 'boolean') {
      $languages->getLanguageConfigOverride('ar', "field.field.user.user.$name")
        ->set('settings.on_label', 'نعم')->set('settings.off_label', 'لا')->save();
    }
  }
}
