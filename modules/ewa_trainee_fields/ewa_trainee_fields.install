  return [
    // ---- Personal information
    'field_national_id' => ['type' => 'string', 'label' => 'National ID / Iqama', 'ar' => 'رقم الهوية الوطنية / الإقامة', 'required' => TRUE, 'storage' => ['max_length' => 10], 'group' => 'personal'],
    'field_first_name' => ['type' => 'string', 'label' => 'First name', 'ar' => 'الاسم الأول', 'required' => TRUE, 'storage' => ['max_length' => 100], 'group' => 'personal'],
    'field_father_name' => ['type' => 'string', 'label' => "Father's name", 'ar' => 'اسم الأب', 'required' => TRUE, 'storage' => ['max_length' => 100], 'group' => 'personal'],
    'field_grandfather_name' => ['type' => 'string', 'label' => "Grandfather's name", 'ar' => 'اسم الجد', 'required' => TRUE, 'storage' => ['max_length' => 100], 'group' => 'personal'],
    'field_last_name' => ['type' => 'string', 'label' => 'Last name', 'ar' => 'اسم العائلة', 'required' => TRUE, 'storage' => ['max_length' => 100], 'group' => 'personal'],
    'field_gender' => ['type' => 'list_string', 'label' => 'Gender', 'ar' => 'الجنس', 'values' => ['male' => ['Male', 'ذكر'], 'female' => ['Female', 'أنثى']], 'group' => 'personal'],
    'field_date_of_birth' => ['type' => 'datetime', 'label' => 'Date of birth', 'ar' => 'تاريخ الميلاد', 'storage' => ['datetime_type' => 'date'], 'group' => 'personal'],
    'field_height' => ['type' => 'integer', 'label' => 'Height (cm)', 'ar' => 'الطول (سم)', 'field' => ['min' => 100, 'max' => 250, 'suffix' => ' cm'], 'group' => 'personal'],
    'field_weight' => ['type' => 'integer', 'label' => 'Weight (kg)', 'ar' => 'الوزن (كجم)', 'field' => ['min' => 30, 'max' => 250, 'suffix' => ' kg'], 'group' => 'personal'],
    'field_mobile' => ['type' => 'string', 'label' => 'Mobile number', 'ar' => 'رقم الجوال', 'storage' => ['max_length' => 9], 'description' => '9 digits starting with 5 (5XXXXXXXX).', 'group' => 'personal'],
    'field_alt_mobile' => ['type' => 'string', 'label' => 'Alternative mobile number', 'ar' => 'رقم جوال بديل', 'storage' => ['max_length' => 9], 'description' => '9 digits starting with 5 (5XXXXXXXX).', 'group' => 'personal'],
    'field_alt_relation' => ['type' => 'string', 'label' => 'Relation to alternative contact', 'ar' => 'صلة القرابة بصاحب الرقم البديل', 'storage' => ['max_length' => 100], 'group' => 'personal'],
    'field_health_declaration' => ['type' => 'boolean', 'label' => 'Health declaration accepted', 'ar' => 'تمت الموافقة على الإقرار الصحي', 'field' => $yes_no, 'group' => 'personal'],

    // ---- Academic information
    'field_qualification' => ['type' => 'list_string', 'label' => 'Qualification', 'ar' => 'المؤهل', 'values' => [
      'high-school' => ['High School', 'الثانوية العامة'],
      'diploma' => ['Diploma', 'دبلوم'],
      'bachelor' => ["Bachelor's Degree", 'بكالوريوس'],
      'master' => ["Master's Degree", 'ماجستير'],
      'other' => ['Other', 'أخرى'],
    ], 'group' => 'academic'],
    'field_major' => ['type' => 'list_string', 'label' => 'Major', 'ar' => 'التخصص', 'values' => [
      'science' => ['Natural Sciences', 'العلوم الطبيعية'],
      'engineering' => ['Engineering', 'الهندسة'],
      'technology' => ['Technology', 'التقنية'],
      'business' => ['Business / Administration', 'إدارة الأعمال'],
      'humanities' => ['Humanities', 'العلوم الإنسانية'],
      'other' => ['Other', 'أخرى'],
    ], 'group' => 'academic'],
    'field_graduation_year' => ['type' => 'integer', 'label' => 'Graduation year', 'ar' => 'سنة التخرج', 'field' => ['min' => 1970, 'max' => 2100], 'group' => 'academic'],
    'field_english_level' => ['type' => 'list_string', 'label' => 'English level', 'ar' => 'مستوى اللغة الإنجليزية', 'values' => [
      'beginner' => ['Beginner', 'مبتدئ'],
      'intermediate' => ['Intermediate', 'متوسط'],
      'advanced' => ['Advanced', 'متقدم'],
      'fluent' => ['Fluent', 'طليق'],
